  var EN_TO_ES = {};
  Object.keys(ES_TO_EN).forEach(function(k){ EN_TO_ES[ES_TO_EN[k]] = k; });

  var ATTR_MAP = {
    placeholder: ES_TO_EN,
    alt: ES_TO_EN
  };

  function translateTextNodes(dict){
    var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
      acceptNode: function(node){
        var tag = node.parentNode && node.parentNode.tagName;
        if(tag === 'SCRIPT' || tag === 'STYLE') return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      }
    });
    var node;
    var nodes = [];
    while((node = walker.nextNode())) nodes.push(node);
    nodes.forEach(function(n){
      var raw = n.nodeValue;
      var trimmed = raw.trim();
      if(!trimmed) return;
      var translation = dict[trimmed];
      if(translation !== undefined){
        n.nodeValue = raw.replace(trimmed, translation);
      }
    });
  }

  function translateAttrs(dict){
    document.querySelectorAll('[placeholder]').forEach(function(el){
      var v = el.getAttribute('placeholder');
      if(dict[v] !== undefined) el.setAttribute('placeholder', dict[v]);
    });
    document.querySelectorAll('img[alt]').forEach(function(el){
      var v = el.getAttribute('alt');
      if(dict[v] !== undefined) el.setAttribute('alt', dict[v]);
    });
  }

  function setLang(lang){
    var dict = lang === 'en' ? ES_TO_EN : EN_TO_ES;
    translateTextNodes(dict);
    translateAttrs(dict);
    document.documentElement.lang = lang;
    window.__conpasLang = lang;
    try{ localStorage.setItem('conpas-lang', lang); }catch(e){}
    var esFlag = document.getElementById('langEs');
    var enFlag = document.getElementById('langEn');
    if(esFlag && enFlag){
      esFlag.classList.toggle('active', lang === 'es');
      enFlag.classList.toggle('active', lang === 'en');
    }
  }

  var esFlag = document.getElementById('langEs');
  var enFlag = document.getElementById('langEn');
  if(esFlag) esFlag.addEventListener('click', function(){ setLang('es'); });
  if(enFlag) enFlag.addEventListener('click', function(){ setLang('en'); });

  var saved = null;
  try{ saved = localStorage.getItem('conpas-lang'); }catch(e){}
  if(saved === 'en') setLang('en');
  else { window.__conpasLang = 'es'; if(esFlag) esFlag.classList.add('active'); }
})();

(function(){
  var toggle = document.getElementById('navToggle');
  var drawer = document.getElementById('mobileNav');
  if(!toggle || !drawer) return;

  function closeDrawer(){
    toggle.classList.remove('open');
    drawer.classList.remove('open');
    document.body.style.overflow = '';
  }
  function toggleDrawer(){
    var isOpen = drawer.classList.toggle('open');
    toggle.classList.toggle('open', isOpen);
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }
  toggle.addEventListener('click', toggleDrawer);
  drawer.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', closeDrawer); });
})();
