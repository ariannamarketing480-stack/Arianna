---

<header>
  <div class="brand-group">
  <a href="/" class="brand-link"><img class="brand-logo" src="data:image/png;base64," alt="CONPAS"></a>
  <div class="lang-switch">
    <button type="button" class="lang-flag active" id="langEs" aria-label="Español">
      <svg viewBox="0 0 24 16"><rect width="24" height="16" fill="#AA151B"/><rect y="4" width="24" height="8" fill="#F1BF00"/></svg>
    </button>
    <button type="button" class="lang-flag" id="langEn" aria-label="English">
      <svg viewBox="0 0 24 16"><rect width="24" height="16" fill="#012169"/><path d="M0 0L24 16M24 0L0 16" stroke="#fff" stroke-width="2.6"/><path d="M0 0L24 16M24 0L0 16" stroke="#C8102E" stroke-width="1.2"/><path d="M12 0V16M0 8H24" stroke="#fff" stroke-width="4.4"/><path d="M12 0V16M0 8H24" stroke="#C8102E" stroke-width="2.4"/></svg>
    </button>
  </div>
  </div>
  <nav>
    <div class="nav-item">
      <a href="#">Empresa</a>
      <div class="mega-menu">
        {EMPRESA_MENU.map((col) => (
          <div class="mega-col">
            {col.groups.map((group) => (
              <>
                <div class="mega-col-title">{group.title}</div>
                {group.items.map((item, i) => (
                  <a class="mega-link" href={item.name === '¿Quiénes somos?' ? '/empresa' : '#'}>
                    <span
                      class="mega-icon c-blue"
                      set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${MEGA_ICON[item.icon]}</svg>`}
                    />
                    {item.name}
                  </a>
                ))}
              </>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div class="nav-item">
      <a href="#">Productos</a>
      <div class="mega-menu">
        {MEGA_MENU.map((col) => (
          <div class="mega-col">
            {col.groups.map((group) => (
              <>
                <div class="mega-col-title">{group.title}</div>
                {group.items.map((item, i) => (
                  <a class={`mega-link ${item.featured ? 'featured' : ''}`} href="#">
                    <span
                      class="mega-icon c-blue"
                      set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${MEGA_ICON[item.icon]}</svg>`}
                    />
                    {item.name}
                    {item.featured && (
                      <svg class="mega-star" viewBox="0 0 20 20"><path d="M10 1.5l2.47 5.63 6.12.55-4.63 4.06 1.4 5.98L10 14.77l-5.36 2.95 1.4-5.98L1.4 7.68l6.12-.55L10 1.5z"/></svg>
                    )}
                  </a>
                ))}
              </>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div class="nav-item">
      <a href="#">Sectores</a>
      <div class="mega-menu">
        <div class="mega-col">
          <div class="mega-col-title">Zoho ERP Sectores</div>
          {SECTORS_MENU.map((item, i) => (
            <a class="mega-link" href="#">
              <span
                class="mega-icon c-blue"
                set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${MEGA_ICON[item.icon]}</svg>`}
              />
              {item.name}
            </a>
          ))}
        </div>
      </div>
    </div>
    <a href="#">Blog</a>
    <a href="/contacto">Contacto</a>
  </nav>
  <div class="header-actions">
    <a class="btn btn-primary" href="/contacto">Solicita información</a>
  </div>
  <button type="button" class="nav-toggle" id="navToggle" aria-label="Abrir menú">
    <span></span><span></span><span></span>
  </button>
</header>

<div class="mobile-nav" id="mobileNav">
  <a href="/empresa">Empresa</a>
  <a href="#">Productos</a>
  <a href="#">Sectores</a>
  <a href="#">Blog</a>
  <a href="/contacto">Contacto</a>
  <a class="btn btn-primary" style="margin-top:8px;" href="/contacto">Solicita información</a>
</div>

