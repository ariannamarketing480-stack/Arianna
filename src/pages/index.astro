// same generator + palette for every section so the confetti reads as one connected background.
// pieces are placed on a jittered grid (not pure random) so they stay evenly spread instead of
// clumping — a few can still touch/cross via the jitter overlap. Pieces whose center falls inside
// `textZone` get a low opacity so any copy sitting on top of them stays readable.
function makeConfettiGrid(seed, cols, rows, textZone, opts = {}) {
  const {
    skipProb = 0.12,
    longRatio = 0.16,
    colStart = -6,
    colEnd = 106,
    rowStart = -8,
    rowEnd = 108,
  } = opts;
  const rand = mulberry32(seed);
  const cellW = (colEnd - colStart) / cols;
  const cellH = (rowEnd - rowStart) / rows;
  const pieces = [];

  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      if (rand() < skipProb) continue;

      const cellLeft = colStart + c * cellW;
      const cellTop = rowStart + r * cellH;
      // jitter within ~65% of the cell: keeps most pieces in their own "slot" (separated)
      // while occasionally drifting far enough to touch/cross a neighbor.
      const left = Math.round(cellLeft + cellW / 2 + (rand() - 0.5) * cellW * 0.65);
      const top = Math.round(cellTop + cellH / 2 + (rand() - 0.5) * cellH * 0.65);

      const isLong = rand() < longRatio;
      // long pieces must always be the ribbon — a triangle stretched this tall turns into an
      // oversized spike (straight sides + oblique cut ends read fine at any length, a triangle doesn't).
      const shape = isLong
        ? 'shape-para'
        : CONFETTI_SHAPES[Math.floor(rand() * CONFETTI_SHAPES.length)];
      const color = CONFETTI_COLORS[Math.floor(rand() * CONFETTI_COLORS.length)];
      const rot = Math.round(rand() * 70 - 35);

      let w, h;
      if (isLong) {
        w = Math.round(34 + rand() * 24);
        h = Math.round(240 + rand() * 220);
      } else if (shape === 'shape-rhombus') {
        // bigger and clearly elongated, like a stretched kite — not a rotated square
        w = Math.round(34 + rand() * 22);
        h = Math.round(w * (2.0 + rand() * 0.9));
      } else if (shape === 'shape-para') {
        // a ribbon must read as a ribbon — w close to h just looks like a clipped square
        w = Math.round(36 + rand() * 26);
        h = Math.round(w * (1.7 + rand() * 0.7));
      } else {
        w = Math.round(48 + rand() * 46);
        h = Math.round(58 + rand() * 70);
      }

      // tall pieces are anchored at their top edge, so a long ribbon can start above the text
      // zone and still visually bleed into it — check the whole vertical span, not just the anchor.
      const heightPct = (h / 1250) * 100; // 1250 ≈ typical combined wrapper height in px
      const verticalOverlap = top <= textZone.y1 && top + heightPct >= textZone.y0;
      const inTextZone = textZone && left >= textZone.x0 && left <= textZone.x1 && verticalOverlap;
      const opacity = inTextZone ? 0.14 : 1;

      pieces.push({ color, shape, left, top, w, h, rot, opacity });
    }
  }
  return pieces;
}

// Hero and "Productos estrella" now share ONE confetti layer sitting behind both sections
// (see hero-featured-wrap below), so pieces near the seam are never sliced by either section's
// own clip-path/overflow — there simply is no boundary inside the shared layer.
// All positions below are still authored as "% of hero" or "% of featured3" for readability,
// then mapped into the combined layer's coordinate space with toHero()/toF3().
const SPLIT_PCT = 42.5; // measured share of the combined height that belongs to the hero section
const toHero = (y) => (y / 100) * SPLIT_PCT;
const toF3 = (y) => SPLIT_PCT + (y / 100) * (100 - SPLIT_PCT);

// text/card-safe zones (mapped into the shared layer) — pieces centered here get faded, not skipped.
// Measured on the live page: the "Productos estrella" title sits at ~15%-25% of featured3's own
// height, with a real, empty ~120px gap between the title and the card row right after it — that
// gap (and the padding above the title) is fair game for full-opacity confetti, not just a blanket fade.
const HERO_TEXT_ZONE = { x0: 0, x1: 54, y0: toHero(4), y1: toHero(90) };
const FEATURED3_TEXT_ZONE = { x0: 0, x1: 64, y0: toF3(11), y1: toF3(29) };
// zohoone's text (h2 + p + button) is centered, so its safe zone is a wide centered band
const ZOHOONE_TEXT_ZONE = { x0: 15, x1: 85, y0: 24, y1: 88 };

// base spread across each section's share of the layer, plus an extra denser pass at each bottom band
const sharedConfetti = [
  ...makeConfettiGrid(7, 7, 6, HERO_TEXT_ZONE, {
    skipProb: 0.38,
    longRatio: 0.05,
    rowStart: toHero(-8),
    rowEnd: toHero(108),
  }),
  ...makeConfettiGrid(6, 5, 2, HERO_TEXT_ZONE, {
    skipProb: 0.55,
    longRatio: 0.05,
    rowStart: toHero(74),
    rowEnd: toHero(98),
  }),
  ...makeConfettiGrid(23, 6, 3, FEATURED3_TEXT_ZONE, {
    skipProb: 0.55,
    longRatio: 0.3,
    rowStart: toF3(2),
    rowEnd: toF3(108),
  }),
  ...makeConfettiGrid(31, 8, 3, FEATURED3_TEXT_ZONE, {
    skipProb: 0.48,
    longRatio: 0.26,
    rowStart: toF3(60),
    rowEnd: toF3(112),
  }),
  // hand-placed accents: some visible pieces on the left, above/beside "Productos estrella"
  { color: 'c-green', shape: 'shape-tri1', left: 3, top: toF3(4), w: 62, h: 92, rot: -10, opacity: 1 },
  { color: 'c-magenta', shape: 'shape-rhombus', left: 12, top: toF3(0), w: 42, h: 100, rot: 8, opacity: 1 },
  { color: 'c-blue', shape: 'shape-para', left: 6, top: toF3(20), w: 54, h: 150, rot: 12, opacity: 0.5 },
  // hand-placed accents: fill the real ~120px gap between the title and the card row
  // (featured3-local ~27%-42% — measured live, not guessed)
  { color: 'c-blue', shape: 'shape-rhombus', left: 47, top: toF3(38), w: 32, h: 72, rot: 6, opacity: 1 },
  { color: 'c-blue', shape: 'shape-tri1', left: 22, top: toF3(37), w: 40, h: 56, rot: -22, opacity: 1 },
  // hand-placed accent: a blue ribbon in the narrow strip to the left of the first app card,
  // running alongside it top to bottom (measured live: card spans ~66.6%-94.2% of the wrap).
  // pulled a bit off the screen edge, not flush against it.
  { color: 'c-blue', shape: 'shape-para', left: 2.6, top: toF3(46), w: 28, h: 250, rot: -5, opacity: 1, isAccent: true },
  // hand-placed accents: two more ribbons in featured3's left margin/gap, spaced apart from the
  // one above instead of stacking right under it.
  { color: 'c-magenta', shape: 'shape-para', left: 3, top: toF3(19), w: 26, h: 140, rot: 6, opacity: 1, isAccent: true },
  { color: 'c-green', shape: 'shape-para', left: 12, top: toF3(19), w: 34, h: 200, rot: -8, opacity: 1, isAccent: true },
  // hand-placed accents: two ribbons in hero's own left margin — moved off the screen edge (there's
  // real room between it and the H1) and spaced further apart vertically than before.
  { color: 'c-blue', shape: 'shape-para', left: 3.1, top: toHero(3), w: 26, h: 180, rot: -4, opacity: 1, isAccent: true },
  { color: 'c-magenta', shape: 'shape-para', left: 11.9, top: toHero(50), w: 28, h: 260, rot: 5, opacity: 1, isAccent: true },
]
  // exclusion zone: a piece kept landing just under the "Ver servicios" button and, with the
  // new shape-para cut, reading as a bright pink rhombus sitting on top of it — drop it outright.
  .filter((p) => !(p.left >= 22 && p.left <= 45 && p.top >= 37 && p.top <= 44))
  // no confetti at all to the right of where the stat card sits — cleared for the full height of
  // both hero and featured3, not just beside the card itself. Deliberate accents are exempt: their
  // placement is hand-verified, not generated blind like the grid pieces these filters target.
  .filter((p) => p.isAccent || p.left < 52)
  // clear the strip between the "Las apps de Zoho más utilizadas" heading and the card row below
  // it (measured live: heading bottom ~57%, cards start ~66.6% of the combined wrap height).
  .filter((p) => p.isAccent || !(p.top <= 68 && p.top + (p.h / 1250) * 100 >= 55))
  // no confetti below the app cards either — drop anything whose visible tail reaches into that
  // bottom strip (measured live: the card row bottom sits at ~94.2% of the combined wrap height).
  .filter((p) => p.isAccent || !(p.top + (p.h / 1250) * 100 >= 92))
  // random grid pieces can land flush against the screen edge (left ~0%) — drop those too; the
  // deliberate accents already sit a bit off the edge on purpose.
  .filter((p) => p.isAccent || p.left >= 1)
  // two random pieces kept landing right behind the hero's dark "Solicita información" button —
  // drop them outright rather than just dimming them, since they clutter it even faded.
  .filter((p) => !(p.left === 20 && p.top === 17) && !(p.left === 29 && p.top === 18))
  .map((p) => {
    // safety net: a piece generated for (or placed in) one section can still be tall enough to
    // visually bleed into the OTHER section's text — re-check every piece against both zones,
    // using its full vertical span, regardless of which grid/zone it was originally built with.
    // this applies to the hand-placed ribbons too, so they fade the same as everything else
    // whenever they cross a text zone, instead of standing out as more solid/colorful.
    const heightPct = (p.h / 1250) * 100;
    const overlapsZone = (zone) =>
      p.left >= zone.x0 && p.left <= zone.x1 && p.top <= zone.y1 && p.top + heightPct >= zone.y0;
    const shouldFade = overlapsZone(HERO_TEXT_ZONE) || overlapsZone(FEATURED3_TEXT_ZONE);
    let opacity = shouldFade ? Math.min(p.opacity, 0.14) : p.opacity;

    // every shape in hero + featured3 must read as translucent, corporate — none fully opaque,
    // not even the deliberate accents — same cap for everyone, no piece stands out as more solid.
    opacity = Math.min(opacity, 0.5);

    return { ...p, opacity };
  });

// same confetti system for the "Zoho One" spotlight section, faded behind its centered text.
// zohoone is much shorter than the shared hero+featured3 layer (~352px vs ~1250px), so piece
// heights (in px) are a much bigger % of its own height — use its real height for the fade check.
const ZOHOONE_HEIGHT_PX = 352;
const zohooneConfetti = [
  ...makeConfettiGrid(41, 8, 5, ZOHOONE_TEXT_ZONE, { skipProb: 0.1, longRatio: 0.12 }),
  { color: 'c-blue', shape: 'shape-para', left: 6, top: -10, w: 40, h: 200, rot: 8, opacity: 1 },
  { color: 'c-magenta', shape: 'shape-para', left: 94, top: -6, w: 38, h: 190, rot: -9, opacity: 1 },
].map((p) => {
  const heightPct = (p.h / ZOHOONE_HEIGHT_PX) * 100;
  const inZone =
    p.left >= ZOHOONE_TEXT_ZONE.x0 &&
    p.left <= ZOHOONE_TEXT_ZONE.x1 &&
    p.top <= ZOHOONE_TEXT_ZONE.y1 &&
    p.top + heightPct >= ZOHOONE_TEXT_ZONE.y0;
  return inZone ? { ...p, opacity: 0.1 } : p;
});

// newsletter section: same confetti system, but the user wants it transparent overall here
// (not just behind the text), since it's a small, dark, understated closing bar.
const NEWSLETTER_HEIGHT_PX = 240;
const NEWSLETTER_TEXT_ZONE = { x0: 0, x1: 45, y0: 30, y1: 80 };
const newsletterConfetti = makeConfettiGrid(53, 6, 3, NEWSLETTER_TEXT_ZONE, {
  skipProb: 0.25,
  longRatio: 0.12,
}).map((p) => {
  const heightPct = (p.h / NEWSLETTER_HEIGHT_PX) * 100;
  const inZone =
    p.left >= NEWSLETTER_TEXT_ZONE.x0 &&
    p.left <= NEWSLETTER_TEXT_ZONE.x1 &&
    p.top <= NEWSLETTER_TEXT_ZONE.y1 &&
    p.top + heightPct >= NEWSLETTER_TEXT_ZONE.y0;
  return { ...p, opacity: inZone ? 0.1 : 0.5 };
});
