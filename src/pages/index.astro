<script is:inline>
function initCarousel(cfg){
  var track = document.getElementById(cfg.trackId);
  var dotsWrap = document.getElementById(cfg.dotsId);
  var carousel = document.querySelector(cfg.carouselSel);
  if(!track) return;

  var originalCards = Array.prototype.slice.call(track.children);
  // duplicate the set once so the scroll can loop seamlessly
  originalCards.forEach(function(card){
    track.appendChild(card.cloneNode(true));
  });

  var setWidth = 0;
  function measure(){
    setWidth = 0;
    var gap = cfg.gap || 16;
    originalCards.forEach(function(card){ setWidth += card.getBoundingClientRect().width + gap; });
  }
  measure();
  window.addEventListener('resize', measure);

  var perView = window.innerWidth <= 880 ? 1 : (cfg.perView || 4);
  var pages = Math.ceil(originalCards.length / perView);
  for(var i=0;i<pages;i++){
    var d = document.createElement('div');
    d.className = 'apps-dot' + (i===0 ? ' active' : '');
    dotsWrap.appendChild(d);
  }
  function updateDots(){
    var pos = track.scrollLeft % setWidth;
    var page = Math.round(pos / (setWidth/pages)) % pages;
    Array.prototype.forEach.call(dotsWrap.children, function(d,idx){
      d.classList.toggle('active', idx===page);
    });
  }

  var SPEED = cfg.speed || 0.45; // px per frame, slow drift
  var playing = false;
  var rafId = null;
  var resumeTimer = null;
  var pos = 0;

  function frame(){
    if(!playing) return;
    pos += SPEED;
    if(setWidth && pos >= setWidth){
      pos -= setWidth;
    }
    track.scrollLeft = pos;
    updateDots();
    rafId = requestAnimationFrame(frame);
  }
  function play(){
    if(playing) return;
    playing = true;
    pos = track.scrollLeft;
    rafId = requestAnimationFrame(frame);
  }
  function pause(){
    playing = false;
    if(rafId) cancelAnimationFrame(rafId);
  }
  function pauseThenResume(delay){
    pause();
    if(resumeTimer) clearTimeout(resumeTimer);
    resumeTimer = setTimeout(play, delay || 2600);
  }

  // start only once the carousel scrolls into view; stop when it leaves
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting) play(); else pause();
    });
  }, {threshold: 0.35});
  io.observe(carousel);

  // pause on manual interaction, resume shortly after
  ['mouseenter','touchstart','pointerdown'].forEach(function(ev){
    carousel.addEventListener(ev, function(){ pauseThenResume(3200); });
  });
  carousel.addEventListener('mouseleave', function(){ pauseThenResume(600); });

  document.getElementById(cfg.nextId).addEventListener('click', function(){
    pauseThenResume(3200);
    track.scrollBy({left: track.clientWidth, behavior:'smooth'});
  });
  document.getElementById(cfg.prevId).addEventListener('click', function(){
    pauseThenResume(3200);
    track.scrollBy({left: -track.clientWidth, behavior:'smooth'});
  });

  // manual drag support
  var isDown=false, startX=0, startScroll=0;
  track.addEventListener('pointerdown', function(e){
    isDown = true; track.classList.add('is-dragging');
    startX = e.clientX; startScroll = track.scrollLeft;
  });
  window.addEventListener('pointerup', function(){ isDown=false; track.classList.remove('is-dragging'); });
  window.addEventListener('pointermove', function(e){
    if(!isDown) return;
    track.scrollLeft = startScroll - (e.clientX - startX);
  });
}

initCarousel({trackId:'appsTrack', dotsId:'appsDots', carouselSel:'.apps-carousel:not(.cases-carousel)', nextId:'appsNext', prevId:'appsPrev'});
initCarousel({trackId:'casesTrack', dotsId:'casesDots', carouselSel:'.cases-carousel', nextId:'casesNext', prevId:'casesPrev'});

(function(){
  var cdVisual = document.querySelector('.cd-visual');
  if(!cdVisual) return;
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        cdVisual.classList.add('cd-play');
      } else {
        cdVisual.classList.remove('cd-play');
      }
    });
  }, {threshold: 0.4});
  io.observe(cdVisual);
})();

(function(){
  var chart = document.getElementById('whyChart');
  var wrap = document.getElementById('whyWrap');
  if(!chart || !wrap) return;
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        chart.classList.add('in-view');
        wrap.querySelectorAll('.why-point').forEach(function(p){ p.classList.add('in-view'); });
      } else {
        chart.classList.remove('in-view');
        wrap.querySelectorAll('.why-point').forEach(function(p){ p.classList.remove('in-view'); });
      }
    });
  }, {threshold: 0.4});
  io.observe(chart);

  wrap.querySelectorAll('.why-label').forEach(function(label){
    label.addEventListener('click', function(e){
      e.stopPropagation();
      var tooltip = label.nextElementSibling;
      var isOpen = tooltip.classList.contains('open');
      wrap.querySelectorAll('.why-tooltip.open').forEach(function(t){ t.classList.remove('open'); });
      wrap.querySelectorAll('.why-label.active').forEach(function(l){ l.classList.remove('active'); });
      if(!isOpen){
        tooltip.classList.add('open');
        label.classList.add('active');
      }
    });
  });
  document.addEventListener('click', function(){
    wrap.querySelectorAll('.why-tooltip.open').forEach(function(t){ t.classList.remove('open'); });
    wrap.querySelectorAll('.why-label.active').forEach(function(l){ l.classList.remove('active'); });
  });
})();

(function(){
  var stats = document.getElementById('casesStats');
  if(!stats) return;
  var nums = Array.prototype.slice.call(stats.querySelectorAll('.cases-stat-num'));
  var DURATION = 1400;
  var running = false;

  function runCount(){
    if(running) return;
    running = true;
    var start = null;
    function step(ts){
      if(start === null) start = ts;
      var progress = Math.min((ts - start) / DURATION, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      nums.forEach(function(el){
        var target = parseInt(el.dataset.count, 10);
        var suffix = el.dataset.suffix || '';
        el.textContent = Math.round(target * eased) + suffix;
      });
      if(progress < 1){
        requestAnimationFrame(step);
      } else {
        running = false;
      }
    }
    requestAnimationFrame(step);
  }

  function resetCount(){
    nums.forEach(function(el){ el.textContent = '0'; });
  }

  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        resetCount();
        runCount();
      }
    });
  }, {threshold: 0.4});
  io.observe(stats);
})();
</script>

<script is:inline>
(function(){
  var btn = document.getElementById('chatbotBtn');
  var panel = document.getElementById('chatbotPanel');
  var body = document.getElementById('chatbotBody');
  var input = document.getElementById('chatbotInput');
  var sendBtn = document.getElementById('chatbotSend');
  var suggestions = document.getElementById('chatbotSuggestions');
  var tease = document.getElementById('chatbotTease');
  if(!btn || !panel) return;

  var answered = false;
  var demoAnswerEs = "¡Buena pregunta! Somos Partner Premium de Zoho en España con más de 15 años de experiencia: ayudamos con consultoría, implementación, migración, integraciones y soporte de todo el ecosistema Zoho. Si quieres, déjanos tu email en el formulario de contacto y un especialista te escribe enseguida 🙂";
  var demoAnswerEn = "Good question! We're a Zoho Premium Partner in Spain with over 15 years of experience: we help with consulting, implementation, migration, integrations and support across the whole Zoho ecosystem. If you'd like, leave us your email in the contact form and a specialist will write to you right away 🙂";
  var demoFollowupEs = "Esto es solo una demo visual del asistente — ¡pero así se vería la conversación en la web real! 😊";
  var demoFollowupEn = "This is just a visual demo of the assistant — but this is how the conversation would look on the real site! 😊";
  function isEnglish(){ return window.__conpasLang === 'en'; }

  function toggle(){
    var isOpen = panel.classList.toggle('open');
    btn.classList.toggle('open', isOpen);
    if(isOpen){
      setTimeout(function(){ input.focus(); }, 200);
      if(tease) tease.classList.add('hidden');
    }
  }
  btn.addEventListener('click', toggle);

  function addMessage(text, who){
    var div = document.createElement('div');
    div.className = 'chatbot-msg ' + who;
    div.textContent = text;
    body.appendChild(div);
    body.scrollTop = body.scrollHeight;
  }

  function respond(){
    if(suggestions) suggestions.style.display = 'none';
    var typing = document.createElement('div');
    typing.className = 'chatbot-typing';
    typing.innerHTML = '<span></span><span></span><span></span>';
    body.appendChild(typing);
    body.scrollTop = body.scrollHeight;
    setTimeout(function(){
      typing.remove();
      addMessage(isEnglish() ? demoAnswerEn : demoAnswerEs, 'bot');
      answered = true;
    }, 1100);
  }

  function handleSend(text){
    text = (text || '').trim();
    if(!text) return;
    addMessage(text, 'user');
    input.value = '';
    if(!answered) respond();
    else {
      setTimeout(function(){
        addMessage(isEnglish() ? demoFollowupEn : demoFollowupEs, 'bot');
      }, 700);
    }
  }

  sendBtn.addEventListener('click', function(){ handleSend(input.value); });
  input.addEventListener('keydown', function(e){
    if(e.key === 'Enter') handleSend(input.value);
  });
  if(suggestions){
    suggestions.querySelectorAll('.chatbot-chip').forEach(function(chip){
      chip.addEventListener('click', function(){ handleSend(chip.textContent); });
    });
  }
})();
</script>

