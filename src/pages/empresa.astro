<style>
  .empresa-about{padding-top:88px;}

  .local-teams{
    background:linear-gradient(180deg,var(--blue) 0%, var(--blue-deep) 100%);
    color:#fff;
    padding:122px 0 76px;
    position:relative;
    margin-top:-50px;
    overflow:hidden;
    clip-path: polygon(0% 0px, 100% 50px, 100% 100%, 0% 100%);
  }
  .local-teams .section-eyebrow{color:#fff;}
  .local-teams .section-eyebrow::before{
    background-color:#fff;background-origin:content-box;border-radius:4px;padding:3px;
    box-shadow:0 2px 6px -2px rgba(0,0,0,0.35);
  }
  .local-grid{display:grid;grid-template-columns:1.15fr 0.85fr;gap:52px;align-items:start;}
  .local-text h2{color:#fff;font-size:29px;margin:0 0 16px;line-height:1.3;}
  .local-text > p{color:rgba(255,255,255,0.88);font-size:15.5px;line-height:1.7;margin:0 0 26px;max-width:560px;}
  .local-benefits{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:13px;}
  .local-benefits li{position:relative;padding-left:30px;font-size:14.5px;font-weight:600;line-height:1.5;}
  .local-benefits li::before{
    content:"✓";position:absolute;left:0;top:-1px;width:20px;height:20px;border-radius:50%;
    background:rgba(255,255,255,0.16);display:flex;align-items:center;justify-content:center;
    font-size:12px;font-weight:800;line-height:20px;text-align:center;
  }
  .local-keys-title{
    color:#fff;font-family:'Sora',sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;
    letter-spacing:.06em;margin:0 0 16px;opacity:.85;
  }
  .local-key-card{
    background:#fff;border-radius:var(--radius);padding:18px 20px;margin-bottom:14px;
    box-shadow:0 16px 32px -20px rgba(10,15,30,0.4);
  }
  .local-key-card:last-child{margin-bottom:0;}
  .local-key-card p{margin:0;font-size:13.8px;line-height:1.6;color:var(--ink);font-weight:600;}

  .trayectoria{background:var(--paper);padding:122px 0 76px;position:relative;margin-top:-50px;overflow:hidden;clip-path: polygon(0% 0px, 100% 50px, 100% 100%, 0% 100%);}

  .tray-chart-wrap{position:relative;width:100%;margin:20px auto 8px;}
  .tray-flow{position:relative;height:60px;}
  .tray-flow-svg{position:absolute;inset:0;width:100%;height:100%;
    clip-path:inset(0 100% 0 0);
    animation-name:whyFlowReveal;animation-duration:1s;animation-timing-function:linear;animation-delay:.6s;animation-fill-mode:forwards;
  }
  /* carries the line out to the true screen edges, same technique as .why-line-edge on the home page */
  .tray-line-edge-left{right:100%;top:83.3%;animation-delay:.1s;}
  .tray-line-edge-right{left:100%;top:83.3%;animation-delay:1.6s;}
  .tray-row{display:flex;justify-content:space-between;gap:12px;margin-top:-22px;position:relative;z-index:1;}
  .tray-point{display:flex;flex-direction:column;align-items:center;width:172px;flex:0 0 auto;opacity:0;
    animation-name:whyPointIn;animation-duration:.5s;animation-timing-function:ease;animation-fill-mode:forwards;
  }
  .tray-dot{width:12px;height:12px;border-radius:50%;background:rgba(20,22,27,0.55);flex:none;}
  .tray-stem{width:1px;height:36px;background:rgba(20,22,27,0.16);}
  .tray-pill{background:#fff;border:1px solid var(--line);border-radius:16px;padding:10px 16px;box-shadow:0 8px 18px -12px rgba(20,30,60,0.25);text-align:center;margin-top:8px;}
  .tray-year{font-family:'Sora',sans-serif;font-weight:800;font-size:13.5px;color:var(--blue);margin-bottom:2px;}
  .tray-title{font-family:'Sora',sans-serif;font-weight:700;font-size:13px;margin-bottom:3px;line-height:1.25;}
  .tray-desc{font-size:12px;color:var(--ink-soft);line-height:1.4;}

  /* momentary reset state used by the scroll-replay JS, same technique as .why-resetting:
     forces animation-name:none via a class (not inline style) so it doesn't wipe each
     element's own inline animation-delay */
  .tray-chart-wrap.tray-resetting .tray-flow-svg,
  .tray-chart-wrap.tray-resetting .tray-line-edge-left,
  .tray-chart-wrap.tray-resetting .tray-line-edge-right,
  .tray-chart-wrap.tray-resetting .why-confetti,
  .tray-chart-wrap.tray-resetting .tray-point{
    animation-name: none;
  }

  @media (prefers-reduced-motion: reduce){
    .tray-flow-svg, .tray-line-edge-left, .tray-line-edge-right{animation:none;clip-path:inset(0 0 0 0);}
    .tray-point{animation:none;opacity:1;}
  }

  /* mobile-only stand-in for the line chart, hidden on desktop */
  .tray-mobile-list{display:none;flex-direction:column;gap:14px;margin:8px 0 0;}
  .tray-mobile-item{display:flex;gap:14px;background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;}
  .tray-mobile-dot{width:10px;height:10px;border-radius:50%;background:rgba(20,22,27,0.55);flex:none;margin-top:5px;}
  .tray-mobile-year{font-family:'Sora',sans-serif;font-weight:800;font-size:12.5px;color:var(--blue);margin-bottom:2px;}
  .tray-mobile-item h4{margin:0 0 4px;font-size:14.5px;}
  .tray-mobile-item p{margin:0;font-size:13px;line-height:1.55;color:var(--ink-soft);}

  @media (max-width:880px){
    .empresa-about{padding-top:56px;}
    .local-grid{grid-template-columns:1fr;gap:36px;}
    .tray-chart-wrap{display:none;}
    .tray-mobile-list{display:flex;}
  }
</style>

