  var wrap = document.getElementById('trayWrap');
  if(!wrap) return;

  // replay the line/points/confetti reveal every time the graphic scrolls into view,
  // from either direction — same technique as the "why" chart on the home page: force
  // animation-name:none via a class (not inline style, which would wipe the per-element
  // animation-delay already set in each element's own style attribute).
  function replayTrayAnimation(){
    wrap.classList.add('tray-resetting');
    void wrap.offsetWidth;
    wrap.classList.remove('tray-resetting');
  }
  var trayIo = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting) replayTrayAnimation();
    });
  }, {threshold: 0.3});
  trayIo.observe(wrap);
})();
</script>
</Layout>
