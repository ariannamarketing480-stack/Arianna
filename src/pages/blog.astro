    <span class="confetti c-blue shape-para confetti-drift" style="left:3%;top:30%;width:16px;height:40px;rotate:-12deg;animation-delay:.35s,.85s;"></span>
    <span class="confetti c-green shape-rhombus confetti-drift" style="left:40%;top:82%;width:18px;height:40px;animation-delay:.45s,.15s;"></span>
    <span class="confetti c-magenta shape-tri2 confetti-drift" style="left:26%;top:88%;width:20px;height:20px;rotate:20deg;animation-delay:.25s,.5s;"></span>
    <span class="confetti c-blue shape-tri1 confetti-drift" style="left:6%;top:8%;width:18px;height:18px;rotate:-10deg;animation-delay:.6s,.35s;"></span>
    <span class="confetti c-green shape-rhombus confetti-drift" style="left:16%;top:22%;width:16px;height:34px;animation-delay:.4s,.75s;"></span>
    <span class="confetti c-magenta shape-para confetti-drift" style="left:27%;top:6%;width:14px;height:36px;rotate:16deg;animation-delay:.2s,.55s;"></span>
    <span class="confetti c-blue shape-tri2 confetti-drift" style="left:37%;top:18%;width:18px;height:18px;rotate:22deg;animation-delay:.5s,.1s;"></span>
