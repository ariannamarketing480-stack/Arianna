<Layout title="CONPAS · Blog" description="Guías, novedades y casos de éxito sobre Zoho CRM, ERP e implantaciones, escritos por el equipo de Conpas.">
<Header />

<section class="blog-hero">
  <div class="hero-ambient" aria-hidden="true">
    <span class="confetti c-blue shape-tri1 confetti-drift" style="left:52%;top:14%;width:22px;height:22px;rotate:-18deg;animation-delay:.1s,0s;"></span>
    <span class="confetti c-green shape-para confetti-drift" style="left:58%;top:55%;width:18px;height:64px;rotate:14deg;animation-delay:.5s,.9s;"></span>
    <span class="confetti c-magenta shape-rhombus confetti-drift" style="left:64%;top:22%;width:20px;height:44px;animation-delay:.3s,.4s;"></span>
    <span class="confetti c-blue shape-tri2 confetti-drift" style="left:70%;top:68%;width:24px;height:24px;rotate:26deg;animation-delay:.6s,.2s;"></span>
    <span class="confetti c-green shape-tri1 confetti-drift" style="left:76%;top:32%;width:18px;height:18px;animation-delay:.2s,.7s;"></span>
    <span class="confetti c-magenta shape-para confetti-drift" style="left:82%;top:60%;width:16px;height:52px;rotate:-22deg;animation-delay:.7s,.3s;"></span>
    <span class="confetti c-blue shape-rhombus confetti-drift" style="left:88%;top:18%;width:20px;height:44px;animation-delay:.4s,1.1s;"></span>
    <span class="confetti c-green shape-tri2 confetti-drift" style="left:94%;top:48%;width:22px;height:22px;rotate:16deg;animation-delay:.15s,.6s;"></span>
    <span class="confetti c-magenta shape-tri1 confetti-drift" style="left:8%;top:70%;width:18px;height:18px;animation-delay:.55s,.25s;"></span>
    <span class="confetti c-blue shape-para confetti-drift" style="left:3%;top:30%;width:16px;height:40px;rotate:-12deg;animation-delay:.35s,.85s;"></span>
    <span class="confetti c-green shape-rhombus confetti-drift" style="left:40%;top:82%;width:18px;height:40px;animation-delay:.45s,.15s;"></span>
    <span class="confetti c-magenta shape-tri2 confetti-drift" style="left:26%;top:88%;width:20px;height:20px;rotate:20deg;animation-delay:.25s,.5s;"></span>
    <span class="confetti c-blue shape-tri1 confetti-drift" style="left:6%;top:8%;width:18px;height:18px;rotate:-10deg;animation-delay:.6s,.35s;"></span>
    <span class="confetti c-green shape-rhombus confetti-drift" style="left:16%;top:22%;width:16px;height:34px;animation-delay:.4s,.75s;"></span>
    <span class="confetti c-magenta shape-para confetti-drift" style="left:27%;top:6%;width:14px;height:36px;rotate:16deg;animation-delay:.2s,.55s;"></span>
    <span class="confetti c-blue shape-tri2 confetti-drift" style="left:37%;top:18%;width:18px;height:18px;rotate:22deg;animation-delay:.5s,.1s;"></span>
    <span class="confetti c-green shape-tri1 confetti-drift" style="left:45%;top:7%;width:16px;height:16px;animation-delay:.3s,.65s;"></span>
    <span class="confetti c-magenta shape-rhombus confetti-drift" style="left:96%;top:6%;width:18px;height:38px;rotate:-14deg;animation-delay:.45s,.2s;"></span>
  </div>
  <div class="wrap">
    <h1>Blog</h1>
    <p>Guías, novedades y casos reales sobre cómo traducir tu negocio al lenguaje Zoho.</p>
  </div>
</section>

{SECTIONS.map((section) => (
  <section class="blog-section">
    <div class="wrap">
      <div class="section-head">
        <div class="section-eyebrow">{section.eyebrow}</div>
        <h2>{section.title}</h2>
      </div>
      <div class="blog-grid">
        {section.posts.map((post) => (
          <a class="blog-card" href="#">
            <div class="blog-card-image">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10.5" r="1.6"/><path d="M21 16l-5.5-5.5-4 4-2.5-2.5-5 5"/></svg>
            </div>
            <div class="blog-card-body">
              <div class={`blog-card-tag ${section.color}`}>{post.tag}</div>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <div class="blog-card-meta"><span>{post.date}</span><span>·</span><span>{post.read} de lectura</span></div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
))}

<section class="newsletter">
  <div class="confetti-bg" aria-hidden="true">
    {newsletterConfetti.map((p) => (
      <span
        class={`confetti ${p.color} ${p.shape}`}
        style={`left:${p.left}%; top:${p.top}%; width:${p.w}px; height:${p.h}px; transform:rotate(${p.rot}deg) translateZ(0); opacity:${p.opacity};`}
      />
    ))}
  </div>
  <div class="wrap nl-row">
    <div>
      <h3>Suscríbete a nuestra newsletter</h3>
      <p>Te mantenemos informado de todas las novedades de Zoho.</p>
    </div>
    <div class="nl-form">
      <input type="email" placeholder="Tu email">
      <button>Suscribirse</button>
    </div>
  </div>
</section>

<Footer />

<style>
  /* full-bleed ribbon of the same always-drifting confetti as the hero, edge to edge across the
     screen — the rest of the blog is plain white cards, so this is the one place that ties it
     back to the site's brand/visual language instead of reading as a separate, flatter page. */
  .blog-hero{position:relative;overflow:hidden;padding:110px 0 64px;}
  .blog-hero > .wrap{position:relative;z-index:1;}
  .blog-hero h1{font-size:56px;font-family:'Sora',sans-serif;font-weight:800;margin:0 0 12px;letter-spacing:-0.5px;}
  .blog-hero p{font-size:16px;color:var(--ink-soft);max-width:560px;margin:0;}

  .blog-section{padding:20px 0 56px;}
  .blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}

  .blog-card{
    display:block;background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;
    box-shadow:0 16px 40px -28px rgba(20,30,60,0.18);color:inherit;text-decoration:none;
    transition:border-color .25s ease, box-shadow .25s ease, transform .25s ease;
  }
  .blog-card:hover{border-color:var(--blue);transform:translateY(-4px);box-shadow:0 20px 44px -24px rgba(20,30,60,0.28);}

  /* placeholder for a real photo per post — plain and neutral on purpose, not tinted per
     category like the tag below, since it'll be replaced by an actual image later. */
  .blog-card-image{aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;background:var(--mist);}
  .blog-card-image svg{width:34px;height:34px;stroke:var(--ink-soft);opacity:.5;}

  .blog-card-body{padding:20px 22px 22px;}
  .blog-card-tag{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:4px 10px;border-radius:999px;margin-bottom:10px;}
  .blog-card-tag.c-blue{color:var(--blue);background:rgba(51,92,170,0.09);}
  .blog-card-tag.c-green{color:var(--green);background:rgba(32,178,76,0.10);}
  .blog-card-tag.c-magenta{color:var(--magenta);background:rgba(189,32,88,0.10);}
  .blog-card h3{font-size:16.5px;margin:0 0 8px;line-height:1.35;}
  .blog-card-body p{font-size:13.5px;line-height:1.6;color:var(--ink-soft);margin:0 0 14px;}
  .blog-card-meta{font-size:12px;color:var(--ink-soft);display:flex;gap:6px;}

  @media (max-width:880px){
    .blog-hero{padding-top:56px;}
    .blog-hero h1{font-size:38px;}
    /* the ribbon's pieces are laid out for the title sitting in the left ~50% of a wide screen —
       on a narrow one the title/subtitle wrap across most of the width instead, so several
       pieces would land right on top of the text. Hidden here rather than re-laid-out, same as
       the hero's own N-assembly graphic at this breakpoint. */
    .blog-hero .hero-ambient{display:none;}
    .blog-grid{grid-template-columns:1fr;}
  }
</style>
</Layout>
